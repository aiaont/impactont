    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Temporal Location"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "The point or period in time at or during which a thing occurs, expressed in terms of the OWL-Time ontology."
      }
