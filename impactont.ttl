@prefix : <http://w3id.org/impactont#> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/aiao#comprisesState> a owl:ObjectProperty ;
    rdfs:label "comprisesState"@en ;
    rdfs:domain :State ;
    rdfs:range :State .

<http://w3id.org/impactont> a owl:Ontology ;
    dcterms:description "An ontology for describing how events impact things."@en ;
    dcterms:title "Impact Ontology"@en .

:Impact a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty :hasProvenance ;
            owl:someValuesFrom :Event ],
        :Event ;
    skos:definition "An event with an identifiable provenance." .

:comprisesEvents a owl:ObjectProperty ;
    rdfs:label "comprisesEvents"@en ;
    dcterms:isReplacedBy :comprisesEvent ;
    rdfs:comment "Deprecated. Use comprisesEvent instead." ;
    rdfs:domain :Event ;
    rdfs:range :Event ;
    owl:deprecated true .

:hasIndicatorValue a owl:ObjectProperty ;
    rdfs:label "hasIndicatorValue"@en ;
    rdfs:comment "Assigns a time-dependent value to an indicator in the context of a state." ;
    rdfs:domain :State ;
    rdfs:range :IndicatorValue .

:hasModality a owl:DatatypeProperty ;
    rdfs:label "hasModality"@en ;
    rdfs:comment "This property can only assume one of two values, namely 'counterfactual' and 'real' (as literals of type string)."@en ;
    rdfs:domain :State .

:hasSpatialLocation a owl:ObjectProperty ;
    rdfs:label "hasSpatialLocation"@en ;
    rdfs:domain :Thing ;
    rdfs:range :SpatialLocation .

:hasState a owl:ObjectProperty ;
    rdfs:label "hasState"@en ;
    rdfs:domain :Thing ;
    rdfs:range :State ;
    owl:inverseOf :isStateOf .

:hasStateA a owl:ObjectProperty ;
    rdfs:label "hasStateA"@en ;
    rdfs:domain :Event ;
    rdfs:range :State .

:hasStateB a owl:ObjectProperty ;
    rdfs:label "hasStateB"@en ;
    rdfs:domain :Event ;
    rdfs:range :State .

:impacts a owl:ObjectProperty ;
    rdfs:label "impacts"@en ;
    rdfs:domain :Event ;
    rdfs:range :State ;
    owl:inverseOf :isImpactedBy .

:isDefinedByIndicator a owl:ObjectProperty ;
    rdfs:label "isDefinedByIndicator"@en ;
    rdfs:domain :State ;
    rdfs:range :Indicator ;
    owl:inverseOf :definesState .

:Indicator a owl:Class ;
    rdfs:label "Indicator" ;
    rdfs:comment "Must have a description and a unit of measure. Can optionally have a rationale." ;
    skos:definition "A convention for indicating the state of a thing." .

:IndicatorValue a owl:Class ;
    rdfs:label "IndicatorValue" ;
    rdfs:comment "Must have an rdf:value. Can optionally have a dcterms:source." ;
    skos:definition "The time-dependent value assigned to the indicator that defines the state in question." .

:Process a owl:Class ;
    rdfs:label "Process" ;
    skos:definition "A series of interrelated or interacting events." .

:SpatialLocation a owl:Class ;
    rdfs:label "SpatialLocation"@en ;
    rdfs:comment "This should be described using a spatial ontology, such as the GeoSPARQL Ontology (https://www.ogc.org/standards/geosparql/)."@en ;
    skos:definition "The point or region in space at or within which a thing occurs." .

:comprisesEvent a owl:ObjectProperty ;
    rdfs:label "comprisesEvent"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( :Process :Event ) ] ;
    rdfs:range :Event .

:hasProvenance a owl:ObjectProperty ;
    rdfs:label "hasProvenance"@en ;
    rdfs:comment "This property is used on the State and Impact classes. The range should always be an Event." ;
    rdfs:range :Event .

:hasTemporalLocation a owl:ObjectProperty ;
    rdfs:label "hasTemporalLocation"@en ;
    rdfs:domain :Thing ;
    rdfs:range :TemporalLocation .

:TemporalLocation a owl:Class ;
    rdfs:label "TemporalLocation"@en ;
    rdfs:comment "A point in time is a single time:Instant, while a period in time is defined by two distinct time:Instants (typically using the time:ProperInterval class)."@en ;
    skos:definition "The point or period in time at or during which a thing occurs, expressed in terms of the OWL-Time ontology." .

:Thing a owl:Class ;
    rdfs:label "Thing"@en ;
    rdfs:comment "Thing extends owl:Thing with the property of 'hasState'." ;
    rdfs:subClassOf owl:Thing .

:State a owl:Class ;
    rdfs:label "State"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :TemporalLocation ;
            owl:onProperty :hasTemporalLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom :Event ;
            owl:onProperty :hasProvenance ] ;
    skos:definition "The condition of a thing at a specific point in time, expressed in terms of one or more indicator-value pairs." .

:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "An Event may comprise other Events." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom :TemporalLocation ;
            owl:onProperty :hasTemporalLocation ] ;
    owl:equivalentClass dcmitype:Event,
        prov:InstantaneousEvent ;
    skos:definition "A change in the state of an impactont:Thing." .

